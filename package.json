{
  "name": "life-of-cupra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "poll-market": "node scripts/poll-market.mjs",
    "build": "tsc --noEmit && vite build && node scripts/write-summary.mjs",
    "preview": "vite preview",
    "lint": "npm run lint:md && npm run lint:ts && npm run lint:yaml",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:ts": "tsc --noEmit",
    "lint:yaml": "node scripts/lint-yaml.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "markdownlint-cli": "^0.49.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
